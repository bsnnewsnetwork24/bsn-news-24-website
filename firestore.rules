rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNewsLink(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.headline is string &&
             data.headline.size() >= 1 &&
             data.headline.size() <= 300 &&
             data.url is string &&
             data.url.size() >= 1 &&
             data.url.size() <= 1000 &&
             data.normalizedKey is string &&
             data.normalizedKey.size() >= 1 &&
             data.normalizedKey.size() <= 200 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/news_links/{linkId} {
      allow get: if isSignedIn() && isValidId(linkId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(linkId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'headline', 'url', 'normalizedKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'headline', 'url', 'normalizedKey', 'createdAt', 'updatedAt']) &&
                       isValidNewsLink(incoming());

      allow update: if isSignedIn() &&
                       isValidId(linkId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidNewsLink(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['headline', 'url', 'normalizedKey', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(linkId) && request.auth.uid == userId;
    }
  }
}
